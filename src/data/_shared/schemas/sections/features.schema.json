{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Features",
  "description": "Screenshots selected by hovering or scrolling.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Anchor: /#id."
    },
    "title": {
      "$ref": "../common.schema.json#/definitions/text"
    },
    "text": {
      "$ref": "../common.schema.json#/definitions/text"
    },
    "align": {
      "type": "string",
      "enum": ["split", "center"]
    },
    "interaction": {
      "type": "string",
      "enum": ["hover", "scroll"],
      "default": "hover",
      "description": "hover: preview screenshots without pinning the page (default). scroll: pin the stage and select screenshots as visitors scroll. Small screens and reduced motion show a static list."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "image": {
            "$ref": "../common.schema.json#/definitions/image"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "../common.schema.json#/definitions/link"
            }
          }
        },
        "required": ["title", "text", "image"],
        "additionalProperties": false
      }
    }
  },
  "required": ["title", "steps"],
  "additionalProperties": false
}
