{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hero",
  "description": "Opening section: title, text, actions, screenshots and partner logos.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Anchor: /#id."
    },
    "title": {
      "$ref": "../common.schema.json#/definitions/text"
    },
    "text": {
      "$ref": "../common.schema.json#/definitions/text"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "../common.schema.json#/definitions/link"
      }
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 4
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "../common.schema.json#/definitions/image"
      },
      "maxItems": 2,
      "description": "First image: the main window. Second image: the smaller floating window."
    },
    "partners": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "logo": {
                "type": "string"
              },
              "href": {
                "$ref": "../common.schema.json#/definitions/href"
              },
              "logoDark": {
                "type": "string",
                "description": "Optional logo for dark mode. Without it, the logo turns white."
              }
            },
            "required": ["name", "logo"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "string",
      "enum": ["split", "center"],
      "description": "split: text left, screenshots right. center: stacked."
    },
    "expansion": {
      "type": "object",
      "description": "Click a split hero image or its label to expand it while its text slides underneath. Large screens only; static with reduced motion.",
      "properties": {
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.6,
          "description": "Expansion animation duration in seconds."
        },
        "label": {
          "type": "string",
          "description": "Optional override for the shared label in _shared/ui.json → expand. Omit to use the shared default, or set an empty string to hide both the label and cursor. The label stays centred below the image and switches to the collapse label when expanded. Hidden when expansion is unavailable."
        },
        "collapseLabel": {
          "type": "string",
          "description": "Optional override for the shared collapse label in _shared/ui.json → collapse."
        }
      },
      "additionalProperties": false,
      "examples": [{ "duration": 0.6 }, { "label": "View larger" }, { "label": "" }]
    }
  },
  "required": ["title"],
  "additionalProperties": false
}
