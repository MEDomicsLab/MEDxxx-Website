{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Steps",
  "description": "An unnumbered step list with a highlighted selection and adjacent description.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Anchor: /#id."
    },
    "title": {
      "$ref": "../common.schema.json#/definitions/text"
    },
    "text": {
      "$ref": "../common.schema.json#/definitions/text"
    },
    "align": {
      "type": "string",
      "enum": ["split", "center"]
    },
    "items": {
      "$ref": "../common.schema.json#/definitions/items"
    },
    "scrollProgress": {
      "type": "boolean",
      "deprecated": true,
      "description": "Legacy option accepted for existing sites. The current layout ignores it. Extra note by Simon Provost: this deprecation may only affect MEDiml."
    }
  },
  "required": ["title", "items"],
  "additionalProperties": false
}
